# Copy to `.env` and fill in. Loaded automatically via python-dotenv.

# --- LLM provider key ---
# Set the API key for whichever provider your FINWF_MODEL uses. With none set,
# the workflow runs in deterministic offline mode (bundled sample data +
# rule-based analyst), so you can still try it end-to-end.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=

# --- Optional overrides (defaults shown) ---

# Model used by the reasoning nodes. Works with any provider supported by
# LangChain's init_chat_model; the provider is inferred from the name
# (claude-* -> Anthropic, gpt-* -> OpenAI, gemini-* -> Google, ...). Examples:
#   claude-opus-4-8                 (default)
#   gpt-4o
#   gemini-1.5-pro
#   groq:llama-3.3-70b-versatile    (explicit provider:model form)
# Install the matching extra first, e.g. pip install -e ".[openai]".
FINWF_MODEL=claude-opus-4-8

# Force the provider when the model name is ambiguous (e.g. a hosted llama).
# FINWF_MODEL_PROVIDER=openai

# Max output tokens per LLM call.
FINWF_MAX_TOKENS=4096

# Set to 0 to force sample data even when yfinance is installed.
FINWF_ALLOW_LIVE=1

# Where generated memos are written.
# FINWF_OUTPUT_DIR=outputs
