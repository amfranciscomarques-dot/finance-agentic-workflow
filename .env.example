# Copy to `.env` and fill in. Loaded automatically via python-dotenv.

# Required for real LLM analysis. Without it, the workflow runs in deterministic
# offline mode (bundled sample data + rule-based analyst), so you can still try it.
ANTHROPIC_API_KEY=

# --- Optional overrides (defaults shown) ---

# Claude model used by the reasoning nodes.
FINWF_MODEL=claude-opus-4-8

# Max output tokens per LLM call.
FINWF_MAX_TOKENS=4096

# Set to 0 to force sample data even when yfinance is installed.
FINWF_ALLOW_LIVE=1

# Where generated memos are written.
# FINWF_OUTPUT_DIR=outputs
